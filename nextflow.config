nextflow.enable.dsl = 2

params {
    // Inputs (required unless -profile test is used)
    proteome_a        = null
    proteome_b        = null
    go_ann            = null
    go_obo            = null

    // Output
    outdir            = 'results'

    // Embedding
    esm_model         = 'facebook/esm2_t6_8M_UR50D'
    embed_batch_size  = 8
    max_residues      = 1022

    // Pair finding / evaluation
    top_k             = 5
    cosine_threshold  = 0.9
    seed              = 42
    evalue_cutoff     = 1e-3
}

profiles {
    test {
        params.proteome_a = "${projectDir}/testdata/proteome_a.fasta"
        params.proteome_b = "${projectDir}/testdata/proteome_b.fasta"
        params.go_ann     = "${projectDir}/testdata/go_annotations.tsv"
        params.go_obo     = "${projectDir}/testdata/go-basic.mini.obo"
        params.outdir     = 'results/test'
        params.top_k      = 5
        params.embed_batch_size = 16
    }

    full {
        params.proteome_a = "${projectDir}/data/proteome_a.fasta"
        params.proteome_b = "${projectDir}/data/proteome_b.fasta"
        params.go_ann     = "${projectDir}/data/go_annotations.tsv"
        params.go_obo     = "${projectDir}/data/go-basic.obo"
        params.outdir     = 'results/full'
    }

    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    docker {
        docker.enabled      = true
        docker.fixOwnership = true
        process.container   = 'functionalhomology:latest'
    }

    // Use a Python/DIAMOND environment already present on PATH, e.g.
    //   conda activate functionalhomology; nextflow run main.nf -profile test
    local {
        // no extra directive needed
    }
}

process {
    executor      = 'local'
    errorStrategy = 'terminate'
    time          = '2h'
    cpus          = 1
    memory        = '2 GB'

    withLabel: process_low {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '8 GB'
        time   = '1h'
    }
    withLabel: process_embeddings {
        cpus   = 4
        memory = '8 GB'
        time   = '4h'
    }
}

// Keep reports tidy and reproducible
trace {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/trace.tsv"
    fields  = 'task_id,name,status,exit,realtime,%cpu,peak_rss,hash'
}

report {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/nextflow_report.html"
}
